{
  "name": "@trip-mate/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/data/*.test.ts src/ai/tests/*.test.ts src/features/trip-ai/*.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-include=src/data/*.ts --test-coverage-exclude=src/data/*.test.ts --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 src/data/*.test.ts",
    "test:ai": "node --experimental-strip-types --test src/ai/tests/*.test.ts src/features/trip-ai/*.test.ts",
    "test:ai:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-include=src/ai/**/*.ts --test-coverage-include=src/features/trip-ai/*.ts --test-coverage-exclude=**/*.test.ts --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 src/ai/tests/*.test.ts src/features/trip-ai/*.test.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "parse5": "^7.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.14",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "@firebase/app": "0.16.2",
    "@firebase/app-check": "0.13.1",
    "@firebase/ai": "2.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}

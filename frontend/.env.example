# Browser-visible API key. Restrict HTTP referrers and allow only Google Sheets API.
VITE_GOOGLE_SHEETS_API_KEY=
# Spreadsheet ID of the CATALOG containing the 旅程清單 tab.
# Each trip's Spreadsheet ID is maintained in that tab, not here.
VITE_GOOGLE_SHEETS_CATALOG_ID=
# Legacy fallback only: VITE_GOOGLE_SHEETS_SPREADSHEET_ID

# Google OAuth Web application client ID (not an API key or client secret).
# Enable Google Sheets API and Google Drive API in its Cloud project.
VITE_GOOGLE_CLIENT_ID=
# JSON email list. Empty list disables guide access. Browser-visible configuration.
VITE_GUIDE_EMAILS='[]'

# Deployment prefix: / for a custom domain or user site, /repo-name/ for project Pages.
# If unset, GitHub Actions builds infer it from GITHUB_REPOSITORY; local builds use /.
VITE_BASE_PATH=
